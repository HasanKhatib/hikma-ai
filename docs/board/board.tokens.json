    "design":  "DES",
    "planning": "PLAN",
    "brand": "BRAND",
    "legal": "LAW",
    "migration": "MIG",
    "audit": "AUDIT",
    "registry": "REG",
    "templates": "TPL",
    "skills": "SKILL",
    "test": "TEST",
    "ci": "CI",
    "release": "REL"
  }
}
