{
  "_note": "Theme + emoji vocabulary for the board viewer. Map `theme` to your project's design tokens so the board feels native. Labels are free-form; this list only assigns an emoji to the common ones. Everything below is data the viewer reads; no code change needed to re-skin.",
  "name": "default",
  "theme": {
    "bg-canvas": "#FFFFFF",
    "bg-surface": "#FFFFFF",
    "bg-sunken": "#F5F5F5",
    "brand": "#111111",
    "brand-hover": "#242424",
    "brand-subtle": "#F3F4F6",
    "accent": "#3B82F6",
    "text-primary": "#111111",
    "text-secondary": "#6B7280",
    "border": "#E5E7EB",
    "warning": "#F59E0B",
    "danger": "#EF4444",
    "success": "#10B981"
  },
  "assignees": {
    "ai":        { "emoji": "AI",   "label": "AI" },
    "me":        { "emoji": "ME",   "label": "Me" },
    "ai+verify": { "emoji": "AV", "label": "AI + verify" }
  },
  "statuses": {
